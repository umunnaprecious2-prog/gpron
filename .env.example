OPENAI_API_KEY=your_openai_api_key

# Postgres connection string. asyncpg (the driver used here) doesn't
# understand libpq's "sslmode" param, so leave it out of the URL -- SSL is
# enabled automatically in code for any non-local host.
#
# Scheme depends on the provider:
#   - Local Docker Postgres, Neon, Supabase, RDS, or any other plain
#     Postgres host: postgresql+asyncpg://...
#       e.g. postgresql+asyncpg://gpron:gpron@postgres:5432/gpron
#   - CockroachDB Serverless specifically needs a different scheme --
#     cockroachdb+asyncpg:// -- because SQLAlchemy's plain postgres dialect
#     doesn't understand two things CockroachDB does differently (see
#     requirements.txt's sqlalchemy-cockroachdb comment for why):
#       cockroachdb+asyncpg://<user>:<password>@<cluster-host>.cockroachlabs.cloud:26257/<dbname>
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<dbname>

SECRET_KEY=your_jwt_secret_key_minimum_32_chars
EMAIL_SERVICE_KEY=your_email_service_key
MANAGER_CODE=0000

# Comma-separated list of allowed frontend origins for CORS, e.g.
# https://gpron-frontend.onrender.com. Defaults to "*" (any origin) if unset.
ALLOWED_ORIGINS=*

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---------------------------------------------------------------------------
# AI customer support agent (chat widget). Everything here is optional except
# OPENAI_API_KEY (above), which powers the replies. Without it the chat still
# works but answers with a "talk to a person" fallback.
# ---------------------------------------------------------------------------
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Batching: reply after the customer pauses this long (seconds), but never
# wait longer than the max window from their first message.
SUPPORT_INACTIVITY_SECONDS=3
SUPPORT_MAX_BATCH_SECONDS=10
SUPPORT_RETENTION_DAYS=30

# Voice. "auto" = ElevenLabs if its key is set, else OpenAI, else voice off.
# Options: auto | elevenlabs | openai | none
SPEECH_PROVIDER=auto
ELEVENLABS_API_KEY=
# Voice for read-aloud replies; copy an id from your ElevenLabs voice library.
ELEVENLABS_VOICE_ID=
VOICE_MAX_SECONDS=60

# Set to a long random string to enable GET /metrics (Prometheus bearer token).
METRICS_TOKEN=
