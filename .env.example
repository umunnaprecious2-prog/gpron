OPENAI_API_KEY=your_openai_api_key

# Postgres connection string (Neon, CockroachDB Serverless, Supabase, RDS,
# or any other Postgres-compatible host). asyncpg (the driver used here)
# doesn't understand libpq's "sslmode" param, so leave it out of the URL --
# SSL is enabled automatically in code for any non-local host.
# Local Docker Postgres: postgresql+asyncpg://gpron:gpron@postgres:5432/gpron
# CockroachDB Serverless: postgresql+asyncpg://<user>:<password>@<cluster-host>.cockroachlabs.cloud:26257/<dbname>
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<dbname>

SECRET_KEY=your_jwt_secret_key_minimum_32_chars
EMAIL_SERVICE_KEY=your_email_service_key
MANAGER_CODE=0000

# Comma-separated list of allowed frontend origins for CORS, e.g.
# https://gpron-frontend.onrender.com. Defaults to "*" (any origin) if unset.
ALLOWED_ORIGINS=*

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
