{
  "uid": "gpron-support",
  "title": "Gpron support agent",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Customer messages / min",
      "datasource": {
        "type": "prometheus",
        "uid": "gpron-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(gpron_support_messages_total[5m])) * 60",
          "legendFormat": "{{kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gpron-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Replies / min",
      "datasource": {
        "type": "prometheus",
        "uid": "gpron-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(gpron_support_replies_total[5m])) * 60",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gpron-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "AI latency (p50 / p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "gpron-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(gpron_support_ai_latency_seconds_bucket[10m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "gpron-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gpron_support_ai_latency_seconds_bucket[10m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "gpron-prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Batch wait before generation (p50 / p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "gpron-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(gpron_support_batch_wait_seconds_bucket[10m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "gpron-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gpron_support_batch_wait_seconds_bucket[10m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "gpron-prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Messages per batch (avg)",
      "datasource": {
        "type": "prometheus",
        "uid": "gpron-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gpron_support_batch_size_sum[30m])) / sum(rate(gpron_support_batch_size_count[30m]))",
          "legendFormat": "avg",
          "datasource": {
            "type": "prometheus",
            "uid": "gpron-prometheus"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "AI errors / min by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "gpron-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(gpron_support_ai_errors_total[5m])) * 60",
          "legendFormat": "{{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gpron-prometheus"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Transcriptions by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "gpron-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(gpron_support_transcriptions_total[1h]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gpron-prometheus"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Stale replies dropped / duplicates blocked",
      "datasource": {
        "type": "prometheus",
        "uid": "gpron-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(gpron_support_stale_suppressed_total[1h]))",
          "legendFormat": "stale dropped",
          "datasource": {
            "type": "prometheus",
            "uid": "gpron-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (source) (increase(gpron_support_duplicates_prevented_total[1h]))",
          "legendFormat": "dup: {{source}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gpron-prometheus"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Pending conversations (queue depth)",
      "datasource": {
        "type": "prometheus",
        "uid": "gpron-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gpron_support_pending_conversations",
          "legendFormat": "pending",
          "datasource": {
            "type": "prometheus",
            "uid": "gpron-prometheus"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Escalations (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "gpron-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (category) (increase(gpron_support_escalations_total[24h]))",
          "legendFormat": "{{category}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gpron-prometheus"
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "AI tokens / hour",
      "datasource": {
        "type": "prometheus",
        "uid": "gpron-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (increase(gpron_support_ai_tokens_total[1h]))",
          "legendFormat": "{{type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "gpron-prometheus"
          }
        }
      ]
    }
  ],
  "tags": [
    "gpron"
  ]
}